# .env.production.example — P3-DO-09 (#193)
#
# Copy to `.env.production` ON THE STAGING VM ONLY. Never commit the real
# file (.gitignore blocks `.env.production`). Real secret generation +
# rotation is P3-DO-04 (#139).
#
#   cp .env.production.example .env.production
#   # then fill in real values

# ----- PostgreSQL -----
POSTGRES_USER=autochess
POSTGRES_PASSWORD=CHANGE_ME_strong_random
POSTGRES_DB=auto_chess
POSTGRES_REPLICATION_PASSWORD=CHANGE_ME_strong_random

# ----- Redis -----
REDIS_URL=redis://redis:6379

# ----- JWT (32-byte random; see P3-DO-04) -----
# openssl rand -base64 32
JWT_SECRET=CHANGE_ME_openssl_rand_base64_32
JWT_ACCESS_TTL=7d
JWT_REFRESH_TTL=30d

# ----- NestJS -----
NEST_PORT=3000
NODE_ENV=production

# ----- Image tag deployed (set by the release workflow / deploy script) -----
# IMAGE_TAG=v1.2.3
