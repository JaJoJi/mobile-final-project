# P3-DO-19 — Vault dev-mode bootstrap token.
#
# Copy to `vault/root_token.env` (gitignored) on the production host and
# fill in a real random value. This is the one credential that still has
# to exist before Vault exists to store anything else in — dev mode
# removes the unseal-key chicken-and-egg problem, not this one, so it's
# scoped as small as possible: a single bootstrap token, not app secrets.
#
# Generate with: openssl rand -hex 20
VAULT_DEV_ROOT_TOKEN_ID=changeme
