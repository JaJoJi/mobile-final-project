# ----- PostgreSQL -----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=auto_chess
POSTGRES_REPLICATION_PASSWORD=replicator_secret

# ----- pgAdmin -----
PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# ----- Redis -----
REDIS_URL=redis://redis:6379

# ----- JWT -----
JWT_SECRET=dev_jwt_secret_change_me_32_random_bytes_xxxxxxxxxxx
JWT_ACCESS_TTL=7d
JWT_REFRESH_TTL=30d

# ----- NestJS -----
NEST_PORT=3000
NODE_ENV=development

# ----- Flutter / mobile (passed via --dart-define) -----
API_BASE_URL=http://localhost
WS_BASE_URL=ws://localhost

# ----- Grafana (P3-DO-03 observability, scaffolding) -----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
