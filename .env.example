# ----- PostgreSQL -----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=auto_chess
POSTGRES_REPLICATION_PASSWORD=replicator_secret

# ----- pgAdmin -----
PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# ----- Redis -----
REDIS_URL=redis://redis:6379

# ----- JWT -----
JWT_SECRET=dev_jwt_secret_change_me_32_random_bytes_xxxxxxxxxxx
JWT_ACCESS_TTL=7d
JWT_REFRESH_TTL=30d

# ----- NestJS -----
NEST_PORT=3000
NODE_ENV=development

# ----- Logging / limits (P1-BE-01) -----
# pino level: trace|debug|info|warn|error (default: debug in dev, info in prod)
LOG_LEVEL=debug
# Per-user WS messages allowed per rolling second before `rate.limited`.
WS_MSG_PER_SEC=30
# `retryAfter` (seconds) put on a 429 when the handler didn't set its own.
RATE_LIMIT_RETRY_AFTER=1

# ----- Flutter / mobile (passed via --dart-define) -----
API_BASE_URL=http://localhost
WS_BASE_URL=ws://localhost
