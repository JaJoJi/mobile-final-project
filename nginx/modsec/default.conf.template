# Production server block for the nginx + ModSecurity WAF image (#224),
# mounted over the image's default.conf.template (which also drops its
# self-signed :8443 server). Load balancing is the same tested shape as
# nginx/nginx.conf: least_conn over nest-1/2/3, WebSocket on /socket.io/,
# /health passthrough.
#
# ModSecurity is enabled globally by the image (modsecurity.conf +
# setup.conf.template here); nothing per-location is needed.
# Rendered with envsubst at start: ${PORT}, ${SSL_PORT}, ${SSL_*} and
# ${HTTPS_REDIRECT} are env vars below -- nginx variables like $host are
# left alone.

# HTTPS_REDIRECT=on: plain-HTTP requests to the app get 301 -> https.
map "$scheme:${HTTPS_REDIRECT}" $force_https {
    "http:on" 1;
    default   0;
}

upstream backend {
    least_conn;
    server nest-1:3000 max_fails=3 fail_timeout=10s;
    server nest-2:3000 max_fails=3 fail_timeout=10s;
    server nest-3:3000 max_fails=3 fail_timeout=10s;
    keepalive 32;
}

server {
    # Unprivileged image: nginx listens on 8080 inside, compose maps 80->8080.
    listen ${PORT} default_server;
    # HTTPS (#139): same server block, TLS on SSL_PORT (8443 inside, 443 on the host).
    listen ${SSL_PORT} ssl default_server;
    server_name _;

    ssl_certificate     ${SSL_CERT_FILE};
    ssl_certificate_key ${SSL_CERT_KEY_FILE};
    ssl_dhparam         /etc/ssl/certs/dhparam-${SSL_DH_BITS}.pem;
    ssl_protocols       ${SSL_PROTOCOLS};
    ssl_ciphers         ${SSL_CIPHERS};
    ssl_session_cache   shared:SSL:5m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    add_header Strict-Transport-Security "max-age=15552000" always;

    # ─── CORS for browser clients (Flutter web, etc.) ───
    add_header 'Access-Control-Allow-Origin'  '*'                                   always;
    add_header 'Access-Control-Allow-Methods' 'GET, POST, PUT, PATCH, DELETE, OPTIONS' always;
    add_header 'Access-Control-Allow-Headers' 'Content-Type, Authorization, X-Requested-With' always;
    add_header 'Access-Control-Max-Age'       86400                                 always;

    if ($request_method = 'OPTIONS') {
        return 204;
    }

    location = /health {
        proxy_pass http://backend/health;
        access_log off;
    }

    # Prometheus scrapes Nest directly on the private compose network.
    location = /metrics { return 404; }

    location /socket.io/ {
        proxy_pass http://backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 86400;
    }

    location / {
        if ($force_https) { return 301 https://$host$request_uri; }
        proxy_pass http://backend;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Image-provided /healthz (container healthcheck) + local stub_status.
    include includes/location_common.conf;
}
