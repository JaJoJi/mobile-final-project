# P3-DO-20 — production server block. Same load-balancing shape as the
# already-tested dev nginx/nginx.conf (least_conn, WS proxy, /health) —
# deliberately unchanged from that config (devops-toolchain.md §7: avoid
# re-validating new load-balancer behavior). ModSecurity itself is wired
# globally via /etc/nginx/templates/conf.d/modsecurity.conf.template
# (base image) — nothing extra needed in this server block for that.
upstream backend {
    least_conn;
    server nest-1:3000 max_fails=3 fail_timeout=10s;
    server nest-2:3000 max_fails=3 fail_timeout=10s;
    server nest-3:3000 max_fails=3 fail_timeout=10s;
    keepalive 32;
}

server {
    listen 80;
    server_name _;

    # ─── CORS for browser clients (Flutter web, etc.) ───
    # MVP: allow any origin. Tighten before production.
    add_header 'Access-Control-Allow-Origin'  '*'                                   always;
    add_header 'Access-Control-Allow-Methods' 'GET, POST, PUT, PATCH, DELETE, OPTIONS' always;
    add_header 'Access-Control-Allow-Headers' 'Content-Type, Authorization, X-Requested-With' always;
    add_header 'Access-Control-Max-Age'       86400                                 always;

    if ($request_method = 'OPTIONS') {
        return 204;
    }

    location = /health {
        proxy_pass http://backend/health;
        access_log off;
    }

    location /socket.io/ {
        proxy_pass http://backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 86400;
    }

    location / {
        proxy_pass http://backend;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
