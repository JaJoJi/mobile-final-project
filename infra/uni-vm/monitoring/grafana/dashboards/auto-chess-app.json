        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (code) (label_replace(rate(http_server_request_duration_seconds_count{service_name=~\"$service\"}[5m]), \"code\", \"${1}xx\", \"http_response_status_code\", \"(.)..\"))",
          "legendFormat": "{{code}}",
          "refId": "A"
