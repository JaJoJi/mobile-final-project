      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [{ "expr": "app_redis_used_memory_bytes", "legendFormat": "Used memory", "refId": "A" }, { "expr": "app_redis_maxmemory_bytes > 0", "legendFormat": "Configured limit", "refId": "B" }],
      "title": "Redis memory",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
