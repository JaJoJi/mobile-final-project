        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "topk(10, sum by (path) (count_over_time({service=\"vault\", log_type=\"vault_audit\"} | json path=\"request.path\" [$__range])))",
          "legendFormat": "{{path}}",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "no data",
