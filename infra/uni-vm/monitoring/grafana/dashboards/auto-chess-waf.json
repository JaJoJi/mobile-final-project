{
  "uid": "auto-chess-waf",
  "title": "Auto Chess -- WAF (ModSecurity)",
  "description": "OWASP CRS hits from the nginx ModSecurity JSON audit log (Loki). Switch the engine to On when 'Would be blocked' only shows real attacks.",
  "tags": [
    "auto-chess"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "editable": false,
  "graphTooltip": 1,
  "links": [
    {
      "type": "dashboards",
      "title": "Auto Chess",
      "tags": [
        "auto-chess"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "icon": "external link"
    }
  ],
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "ModSecurity (OWASP CRS) -- volume",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Flagged requests (range)",
      "description": "Requests with at least one CRS rule match (includes low-score noise such as numeric-IP Host header).",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({service=\"nginx\", log_type=\"modsec_audit\"}  [$__range]))",
          "legendFormat": "",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Would be blocked (score >= 5)",
      "description": "Inbound anomaly score exceeded (rule 949110). DetectionOnly: logged, still served. Engine On: these get 403.",
