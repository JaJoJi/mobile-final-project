    {
      "type": "timeseries",
      "title": "Flagged requests by attack category / 5m",
      "description": "A request with several matching rules counts once per category.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({service=\"nginx\", log_type=\"modsec_audit\"} |~ `\"ruleId\":\"942\\d+\"` [5m]))",
          "legendFormat": "SQL injection (942)",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({service=\"nginx\", log_type=\"modsec_audit\"} |~ `\"ruleId\":\"941\\d+\"` [5m]))",
          "legendFormat": "XSS (941)",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({service=\"nginx\", log_type=\"modsec_audit\"} |~ `\"ruleId\":\"93[234]\\d+\"` [5m]))",
          "legendFormat": "Command / code injection (932-934)",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({service=\"nginx\", log_type=\"modsec_audit\"} |~ `\"ruleId\":\"93[01]\\d+\"` [5m]))",
          "legendFormat": "Path traversal / LFI (930, 931)",
          "refId": "D"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({service=\"nginx\", log_type=\"modsec_audit\"} |~ `\"ruleId\":\"913\\d+\"` [5m]))",
          "legendFormat": "Scanners / bots (913)",
          "refId": "E"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({service=\"nginx\", log_type=\"modsec_audit\"} |~ `\"ruleId\":\"92[01]\\d+\"` [5m]))",
          "legendFormat": "Protocol violations (920, 921)",
          "refId": "F"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({service=\"nginx\", log_type=\"modsec_audit\"} |~ `\"ruleId\":\"95[019]\\d+\"` [5m]))",
          "legendFormat": "Data leakage in responses (950, 951, 959)",
          "refId": "G"
        }
      ],
