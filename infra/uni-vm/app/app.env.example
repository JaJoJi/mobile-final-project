# Copied to /etc/auto-chess/app.env (root:root, 0600) by site.yml.
# Non-secret settings for compose.yml. Passwords and keys (Postgres, JWT,
# Grafana admin) live in Vault (#223), not here: infra/uni-vm/vault/bootstrap.sh
# moves them there on first setup. Never commit the real file.

POSTGRES_USER=auto_chess
POSTGRES_DB=auto_chess

JWT_ACCESS_TTL=7d
JWT_REFRESH_TTL=30d

LOG_LEVEL=info
COMBAT_DONE_TIMEOUT_MS=60000

# Docker Hub repo Jenkins pushes to (private -> `docker login` with a
# READ-ONLY token on the VM).
IMAGE_REPO=fiatthanapon/mobile-final-project
# WAF mode (#224): DetectionOnly = log attacks, don't block. Switch to On
# once `docker compose logs nginx` shows no false positives on real use.
MODSEC_RULE_ENGINE=DetectionOnly

# Release to run: `latest` = newest main build, or pin a commit tag
# (e.g. d5ec4c4) to stay on / roll back to a specific release.
IMAGE_TAG=latest

# HTTPS (#139): nginx also listens on 443 (self-signed cert from site.yml in
# /etc/auto-chess/tls; replace it with a real cert/key at the same paths).
# `on` makes plain HTTP answer 301 -> https. Keep `off` while the mobile app /
# emulator talk to http://<vm> (they do not trust the self-signed cert).
HTTPS_REDIRECT=off
