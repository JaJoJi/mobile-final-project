# Copied to /etc/auto-chess/app.env (root:root, 0600) by site.yml.
# Production secrets for compose.yml -- never commit the real file.
# Generate secrets with:  openssl rand -hex 32
# Changing POSTGRES_* after the first deploy does NOT change the existing
# database (Postgres reads them only on first init of the volume).

POSTGRES_USER=auto_chess
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=auto_chess
POSTGRES_REPLICATION_PASSWORD=CHANGE_ME

JWT_SECRET=CHANGE_ME
JWT_ACCESS_TTL=7d
JWT_REFRESH_TTL=30d

LOG_LEVEL=info
COMBAT_DONE_TIMEOUT_MS=60000

# Docker Hub repo Jenkins pushes to (private -> `docker login` with a
# READ-ONLY token on the VM).
IMAGE_REPO=fiatthanapon/mobile-final-project
# WAF mode (#224): DetectionOnly = log attacks, don't block. Switch to On
# once `docker compose logs nginx` shows no false positives on real use.
MODSEC_RULE_ENGINE=DetectionOnly

# Release to run: `latest` = newest main build, or pin a commit tag
# (e.g. d5ec4c4) to stay on / roll back to a specific release.
IMAGE_TAG=latest
