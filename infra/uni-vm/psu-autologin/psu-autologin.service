[Unit]
Description=PSU captive portal auto-login (keeps the VM online)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/psu-autologin.env
ExecStart=/usr/local/bin/psu-autologin
# Backoff state lives in /var/lib/psu-autologin.
StateDirectory=psu-autologin
# Least privilege: it only needs the network and its state dir.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
